{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/horoscoop.json",
  "title": "Horoscoop",
  "description": "Full output contract: time, astronomy, western, vedic, chinese, diagnostics. Every value has unit/frame/method/confidence where applicable.",
  "type": "object",
  "required": ["meta", "input", "time", "astronomy"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "generated_at_utc", "engine"],
      "properties": {
        "version": { "type": "string", "description": "Engine schema version semver" },
        "generated_at_utc": { "type": "string", "format": "date-time", "description": "ISO-8601" },
        "engine": {
          "type": "object",
          "properties": {
            "ephemeris_engine": { "type": "string" },
            "house_engine": { "type": "string" },
            "tz_engine": { "type": "string" },
            "code_hash": { "type": ["string", "null"] },
            "license_mode": { "type": ["string", "null"] }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "properties": {
        "birth": {
          "type": "object",
          "properties": {
            "date": { "type": "string", "description": "YYYY-MM-DD" },
            "time_local": { "type": ["string", "null"], "description": "HH:MM:SS" },
            "place": {
              "type": "object",
              "properties": {
                "lat": { "type": ["number", "null"], "description": "WGS84 deg" },
                "lon": { "type": ["number", "null"], "description": "WGS84 deg" },
                "elevation_m": { "type": ["number", "null"], "description": "m" }
              }
            },
            "timezone": {
              "type": "object",
              "properties": {
                "iana": { "type": ["string", "null"] },
                "utc_offset_hours": { "type": ["number", "null"] },
                "utc_offset_minutes": { "type": ["number", "null"] }
              }
            }
          }
        }
      }
    },
    "time": {
      "type": "object",
      "properties": {
        "datetime_utc": { "type": ["string", "null"], "format": "date-time" },
        "datetime_local": { "type": ["string", "null"], "format": "date-time" },
        "jd_ut1": { "type": ["number", "null"], "description": "days" },
        "jd_tt": { "type": ["number", "null"], "description": "days" },
        "jd": { "type": "object", "properties": { "ut1": { "type": "number" }, "tt": { "type": "number" } } },
        "jd_tdb": { "type": ["number", "null"], "description": "days" },
        "delta_t_seconds": { "type": ["number", "null"], "description": "s" },
        "delta_t_source": { "type": ["string", "null"] },
        "ut1_utc_seconds": { "type": ["number", "null"], "description": "s" },
        "ut1_utc_source": { "type": ["string", "null"] },
        "status": {
          "type": "object",
          "properties": {
            "computed": { "type": "boolean" },
            "requires": { "type": "array", "items": { "type": "string", "enum": ["date", "time", "latlon", "timezone", "eop_data"] } },
            "confidence": { "type": "string", "enum": ["high", "medium", "low", "estimated", "unavailable"] },
            "assumptions": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "astronomy": {
      "type": "object",
      "properties": {
        "bodies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "frame": { "type": "string", "enum": ["ecliptic_true_of_date", "icrs_j2000"] },
              "mode": { "type": "string", "enum": ["geocentric", "topocentric"] },
              "zodiac": { "type": "string", "enum": ["tropical", "sidereal"] },
              "lon_deg": { "type": ["number", "null"], "description": "deg" },
              "lat_deg": { "type": ["number", "null"], "description": "deg" },
              "dist_au": { "type": ["number", "null"], "description": "au" },
              "speed_lon_deg_per_day": { "type": ["number", "null"], "description": "deg/day" },
              "flags": { "type": "object" },
              "quality": {
                "type": "object",
                "properties": {
                  "computed": { "type": "boolean" },
                  "confidence": { "type": "string" },
                  "assumptions": { "type": "array", "items": { "type": "string" } }
                }
              },
              "error": { "type": "string" }
            }
          }
        }
      }
    },
    "western": {
      "type": ["object", "null"],
      "properties": {
        "houses": {
          "type": "object",
          "properties": {
            "system": { "type": ["string", "null"], "description": "P,K,R,C,E,W,O,S" },
            "cusps_deg": { "type": ["array", "null"], "items": { "type": "number" }, "maxItems": 12 },
            "angles": {
              "type": "object",
              "properties": {
                "asc_deg": { "type": ["number", "null"] },
                "mc_deg": { "type": ["number", "null"] }
              }
            },
            "status": { "type": "object" }
          }
        },
        "aspects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "a": { "type": "string" },
              "b": { "type": "string" },
              "type": { "type": "string" },
              "exact_angle_deg": { "type": "number" },
              "orb_deg": { "type": "number" },
              "orb_degrees": { "type": "number" },
              "applying": { "type": "boolean" }
            }
          }
        },
        "placements": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "sign": { "type": "string" },
              "degree_in_sign": { "type": "number" },
              "house": { "type": ["integer", "null"] },
              "retrograde": { "type": "boolean" }
            }
          }
        }
      }
    },
    "vedic": {
      "type": ["object", "null"],
      "properties": {
        "at_mode": { "type": "string" },
        "ayanamsha": {
          "type": "object",
          "properties": {
            "mode": { "type": "string" },
            "nutation_included": { "type": ["boolean", "null"] }
          }
        },
        "panchanga": {
          "type": "object",
          "properties": {
            "vaara": { "type": ["string", "null"] },
            "tithi": {
              "type": "object",
              "properties": {
                "index": { "type": ["integer", "null"] },
                "ends_at_local": { "type": ["string", "null"] },
                "ends_at_utc": { "type": ["string", "null"] }
              }
            },
            "nakshatra": {
              "type": "object",
              "properties": {
                "index": { "type": ["integer", "null"] },
                "ends_at_local": { "type": ["string", "null"] },
                "ends_at_utc": { "type": ["string", "null"] }
              }
            },
            "yoga": {
              "type": "object",
              "properties": {
                "index": { "type": ["integer", "null"] },
                "ends_at_local": { "type": ["string", "null"] },
                "ends_at_utc": { "type": ["string", "null"] }
              }
            },
            "karana": { "type": "object", "properties": { "indices": { "type": "array", "items": { "type": "integer" } } } },
            "sunrise_method": { "type": ["string", "null"], "enum": ["astronomical_upper_limb", "hindu_rising"] },
            "status": { "type": "object" }
          }
        },
        "sunrise_time_utc": { "type": ["string", "null"] },
        "sunrise_time_local": { "type": ["string", "null"] },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "chinese": {
      "type": ["object", "null"],
      "properties": {
        "boundary_year": { "type": ["string", "null"], "enum": ["lichun", "cny_lunisolar"] },
        "solar_terms": { "type": ["object", "null"] },
        "ganzhi": {
          "type": "object",
          "properties": {
            "day": {
              "type": "object",
              "properties": {
                "stem": { "type": "string" },
                "branch": { "type": "string" },
                "index_60": { "type": "integer" }
              }
            }
          }
        },
        "bazi_pillars": {
          "type": ["object", "null"],
          "properties": {
            "year": { "type": "object", "properties": { "stem": { "type": "string" }, "branch": { "type": "string" } } },
            "month": { "type": "object", "properties": { "stem": { "type": "string" }, "branch": { "type": "string" } } },
            "day": { "type": "object", "properties": { "stem": { "type": "string" }, "branch": { "type": "string" } } },
            "hour": { "type": "object", "properties": { "stem": { "type": "string" }, "branch": { "type": "string" } } }
          }
        },
        "calendar_day_definition": { "type": ["string", "null"] },
        "status": { "type": "object" }
      }
    },
    "diagnostics": {
      "type": ["object", "null"],
      "properties": {
        "codes": { "type": "array", "items": { "type": "string" } },
        "delta_t_source": { "type": "string" },
        "ut1_utc_source": { "type": "string" }
      }
    }
  }
}
